# Copy to secret.env (same folder) and fill in. NEVER commit secret.env.
# Easiest: run  npm run setup -- --for kubernetes  (writes this file for you).
SUPABASE_SECRET_KEY=sb_secret_xxx
# Only until the first admin account exists; then remove it and re-apply:
SETUP_TOKEN=
# Optional email (invites, resets). Gmail: use an APP PASSWORD, not the normal one.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Or, instead of SMTP, Resend:
RESEND_API_KEY=
EMAIL_FROM=

# Optional meeting recorder (fill in all three plus RECALL_REGION in configmap.yaml, or none):
RECALL_API_KEY=
RECALL_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
