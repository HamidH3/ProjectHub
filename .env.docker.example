# Copy this file to .env.docker and fill it in. NEVER commit .env.docker.
# Easiest: run  npm run setup -- --for docker  (asks questions and writes .env.docker for you),
# then check it with  npm run doctor -- --file .env.docker
#
# Used by docker compose / docker run. The first two are also needed when
# BUILDING the image (they go into the browser code; they are public values).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret: server only. Supabase → Project Settings → API Keys.
SUPABASE_SECRET_KEY=sb_secret_xxx

# The address people use to open the app, no slash at the end.
SITE_URL=https://projecthub.example.com

# Only needed until the first admin account exists (at least 32 characters):
SETUP_TOKEN=

# Optional email (invites, resets). Gmail: use an APP PASSWORD, not the normal one.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Or, instead of SMTP, Resend:
RESEND_API_KEY=
EMAIL_FROM=

# Optional meeting recorder (docs/OPTIONAL-FEATURES.md). Fill in all four, or none.
# Your server must be reachable on HTTPS so Recall.ai can call /api/recall/webhook.
RECALL_API_KEY=
RECALL_REGION=eu-central-1
RECALL_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
# Optional: a cheaper model for summaries, e.g. claude-haiku-5-5 (default claude-sonnet-5-5)
ANTHROPIC_MODEL=
