# Copy this file to .env.docker and fill it in. NEVER commit .env.docker.
#
# Used by docker compose / docker run. The first two are also needed when
# BUILDING the image (they go into the browser code; they are public values).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret: server only. Supabase → Project Settings → API Keys.
SUPABASE_SECRET_KEY=sb_secret_xxx

# The address people use to open the app, no slash at the end.
SITE_URL=https://projecthub.example.com

# Only needed until the first admin account exists (at least 32 characters):
SETUP_TOKEN=

# Optional: emails through Resend
RESEND_API_KEY=
EMAIL_FROM=
